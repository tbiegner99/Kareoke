<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

  <changeSet author="tj" id="2026-07-10-1">
    <addColumn tableName="songs">
      <column name="youtube_url" type="VARCHAR(300)">
        <constraints nullable="true" unique="true" uniqueConstraintName="UQ_songs_youtube_url"/>
      </column>
    </addColumn>
  </changeSet>

  <changeSet author="tj" id="2026-07-10-2">
    <createTable tableName="import_jobs">
      <column autoIncrement="true" name="job_id" type="INTEGER">
        <constraints nullable="false" primaryKey="true" primaryKeyName="PK_import_jobs"/>
      </column>
      <column name="youtube_id" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>
      <column name="youtube_url" type="VARCHAR(300)">
        <constraints nullable="false"/>
      </column>
      <column name="title" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>
      <column name="artist" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>
      <column name="status" type="VARCHAR(30)">
        <constraints nullable="false"/>
      </column>
      <column name="percent" type="NUMERIC(5,2)" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="error" type="VARCHAR(500)"/>
      <column name="song_id" type="INTEGER"/>
      <column defaultValueComputed="CURRENT_TIMESTAMP" name="created" type="TIMESTAMP(0) WITHOUT TIME ZONE">
        <constraints nullable="false"/>
      </column>
      <column defaultValueComputed="CURRENT_TIMESTAMP" name="updated" type="TIMESTAMP(0) WITHOUT TIME ZONE">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

  <changeSet author="tj" id="2026-07-10-3">
    <addForeignKeyConstraint baseTableName="import_jobs" baseColumnNames="song_id"
      constraintName="FK_import_jobs_song" referencedTableName="songs" referencedColumnNames="song_id"
      onDelete="SET NULL"/>
  </changeSet>

</databaseChangeLog>
